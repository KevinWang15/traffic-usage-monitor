{
  "name": "traffic-usage-monitor-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "env:setup": "node scripts/setup-env.js",
    "predev": "npm run env:setup",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "webpack --mode production",
    "start": "node dist/server.js",
    "test": "node --test -r ts-node/register tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "format": "prettier --write 'src/**/*.ts'",
    "preprisma:generate": "npm run env:setup",
    "preprisma:migrate": "npm run env:setup",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "geoip-lite": "^1.4.10",
    "mysql2": "^3.14.1",
    "prisma": "^6.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.21",
    "prettier": "^3.5.3",
    "ts-loader": "^9.5.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  }
}
