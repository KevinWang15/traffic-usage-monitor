# k3s deployment settings
DEPLOYMENT_NAMESPACE=traffic-usage-monitor
DEPLOYMENT_APP_NAME=traffic-usage-monitor
DEPLOYMENT_SERVICE_NAME=traffic-usage-monitor-service
DEPLOYMENT_SECRET_NAME=traffic-usage-monitor-secret
DEPLOYMENT_IMAGE=ghcr.io/your-org/traffic-usage-monitor:latest
DEPLOYMENT_IMAGE_PULL_SECRET=
DEPLOYMENT_REPLICAS=1
DEPLOYMENT_CONTAINER_PORT=3000
DEPLOYMENT_NODE_PORT=25336
DEPLOYMENT_RUN_MIGRATIONS=true
DEPLOYMENT_CREATE_MYSQL=true
DEPLOYMENT_MYSQL_NAME=traffic-usage-monitor-mysql
DEPLOYMENT_MYSQL_SERVICE_NAME=traffic-usage-monitor-mysql
DEPLOYMENT_MYSQL_SECRET_NAME=traffic-usage-monitor-mysql-secret
DEPLOYMENT_MYSQL_IMAGE=mysql:8.4
DEPLOYMENT_MYSQL_PORT=3306
DEPLOYMENT_MYSQL_STORAGE_SIZE=10Gi
DEPLOYMENT_MYSQL_STORAGE_CLASS=

# Optional image registry credentials
GHCR_USERNAME=
GHCR_TOKEN=

# Application settings
PUBLIC_URL=https://traffic-usage-monitor.example.com
APP_VERSION=0.1.0
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-secure-secret
TZ=UTC

# In-cluster MySQL settings
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=traffic_usage_monitor
MYSQL_USER=traffic_usage_monitor
MYSQL_PASSWORD=replace-with-a-strong-app-password

# Optional override. If empty, deploy.sh generates DATABASE_URL from the MySQL settings above.
DATABASE_URL=

# EngageLab email delivery. Required for traffic alert email delivery.
ENGAGE_LAB_USERNAME=
ENGAGE_LAB_API_KEY=
ENGAGE_LAB_FROM_EMAIL=

# Auth email token TTLs
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
