PUBLIC_URL=http://localhost:5173
# Optional Express trust proxy setting. Set to a hop count or proxy subnet when behind a trusted reverse proxy.
TRUST_PROXY=false
# Optional request IP diagnostics for agent join/report.
LOG_AGENT_IP_DEBUG=false
APP_VERSION=0.1.0
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mysql://root:password@127.0.0.1:3306/traffic_usage_monitor
TZ=UTC

# EngageLab email delivery. Required for traffic alert email delivery.
ENGAGE_LAB_USERNAME=
ENGAGE_LAB_API_KEY=
ENGAGE_LAB_FROM_EMAIL=

# Optional Healthchecks.io ping URL. Pinged after each reset sweep.
HEALTHCHECKS_PING_URL=

# Auth email token TTLs
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
